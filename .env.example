APP_NAME="Restaurant Reservations"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Logs go to stderr, as JSON, one object per line — read them with
# `sail logs laravel.test`. This is not only container convention: writing to
# storage/logs/ means writing through the bind mount to the host filesystem, and
# on Docker Desktop that costs about two thirds of the throughput under load.
# Switch to `single` for a file in storage/logs/ if you prefer, and expect that.
LOG_STACK=stderr
LOG_STDERR_FORMATTER=Illuminate\Log\Formatters\JsonFormatter
LOG_DEPRECATIONS_CHANNEL=null
# Normal operation is logged at debug and problems at warning or above, so this
# default records what went wrong and stays quiet about what went right. The
# per-reservation trail — every confirmation and every refusal, with its reason —
# is worth roughly 9% of throughput under load, so it is opt-in:
#
#   LOG_LEVEL=debug  +  sail restart      (see "Following one request" in README)
LOG_LEVEL=info

# --- Sail / Docker -----------------------------------------------------------
# WWWUSER/WWWGROUP must match your host user so files written inside the
# container stay readable from the host. On Linux use $(id -u) / $(id -g);
# on Windows + Docker Desktop / WSL2 the standard value is 1000.
WWWUSER=1000
WWWGROUP=1000
APP_PORT=8080
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379

# Leave this commented out to run Laravel Octane (the default, and what the
# README benchmarks). Uncomment it to fall back to PHP's built-in dev server,
# which is the "before" row of the performance comparison.
# The quotes are required, not cosmetic: the value contains spaces, and dotenv
# rejects the whole file without them ("unexpected whitespace"), which leaves the
# app unable to boot at all.
# SUPERVISOR_PHP_COMMAND="php artisan serve --host=0.0.0.0 --port=80"

# Only used by the line above. Set it to the same number of processes Octane
# gets, so the comparison is about the runtime and not about process count.
PHP_CLI_SERVER_WORKERS=16

# --- Database ----------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

# --- Redis -------------------------------------------------------------------
# Redis holds the atomic seat counters. phpredis ships with the Sail image.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Drivers -----------------------------------------------------------------
# CACHE_STORE must be redis: the rate limiter writes to the cache store on every
# request, and pointing it at the database would add a Postgres write per call.
CACHE_STORE=redis
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Octane ------------------------------------------------------------------
OCTANE_SERVER=swoole
OCTANE_WORKERS=auto

# --- Restaurant --------------------------------------------------------------
RESTAURANT_NAME="Jackeline's Food House"
RESTAURANT_TIMEZONE=America/Bogota
RESERVATIONS_SLOT_MINUTES=30
RESERVATIONS_SEATS_PER_SLOT=40

# Per-minute, per-IP limit on the MCP endpoint. Set to 0 to disable it, which is
# required when running the load test (k6 comes from a single IP and would
# otherwise be throttled).
MCP_RATE_LIMIT=600

# Shared secret for the voice webhook, sent by the caller either as the
# X-Vapi-Secret header or as an Authorization: Bearer token — both are compared
# against this one value. The placeholder is here so the curl example in the
# README works straight after `sail up`; change it before the port is reachable
# from anywhere else. Leaving it empty closes the endpoint instead of opening it.
INTEGRATION_SECRET=change-me

# --- AI (optional) -----------------------------------------------------------
# Natural-language time parsing is an enhancement, never a requirement: without
# a key the app falls back to deterministic parsing and everything still works.
ANTHROPIC_API_KEY=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
